# Copy this file to .env and fill in your values.
# The .env is ignored by git (see .gitignore).

# AWS profile (~/.aws/config). OPTIONAL.
# It scopes the whole app to a single account: credentials, account and region
# are all derived from it.
#   - When set, that named profile is used.
#   - When unset, the standard AWS provider chain is used instead, so the app
#     runs against whatever credentials the launching shell is logged into
#     (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_SESSION_TOKEN, SSO, …).
# You can also pass the profile inline when launching, without editing .env:
#   AWS_PROFILE=my-profile npm run dev
# AWS_PROFILE=my-profile

# Optional region override. If omitted, the profile's own region is used, then
# AWS_REGION / AWS_DEFAULT_REGION from the environment, then a built-in default.
# AWS_REGION=ca-central-1

# Local server port. Optional (default: 3000).
# PORT=3000
